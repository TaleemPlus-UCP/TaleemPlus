# ---- Server ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
# Comma-separated allowlist. REQUIRED (boot fails otherwise) when NODE_ENV=production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Database (PostgreSQL via Prisma) ----
DATABASE_URL="postgresql://taleemplus_app:TaleemPlus_Dev_2026!@localhost:5432/taleemplus_dev?schema=public"
# Used only by `prisma migrate`; same value as DATABASE_URL unless you're
# pointing at a pooled (e.g. PgBouncer/Neon pooler) connection string, in
# which case this must be the direct/unpooled one — Prisma Migrate can't
# reliably run DDL/advisory locks through a transaction pooler.
DIRECT_URL="postgresql://taleemplus_app:TaleemPlus_Dev_2026!@localhost:5432/taleemplus_dev?schema=public"

# ---- JWT ----
JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# ---- Password reset / security question tokens ----
PASSWORD_RESET_TOKEN_EXPIRES_MIN=30
# Deep link / web URL the reset email points to; backend appends ?token=<raw token>
CLIENT_RESET_PASSWORD_URL=https://app.taleemplus.com/reset-password

# ---- SMTP (leave blank in dev to fall back to an Ethereal test inbox; required in production) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=TaleemPlus
SMTP_FROM_EMAIL=no-reply@taleemplus.app

# ---- Cloudinary (used by later file-upload module) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=10

# ---- Logging ----
LOG_LEVEL=info
