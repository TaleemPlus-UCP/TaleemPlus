generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum AccountStatus {
  ACTIVE
  PENDING
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum FeeStatus {
  PENDING
  PAID
  OVERDUE
}

model Academy {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  address   String?
  phone     String?
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  classes           Class[]
  attendanceRecords AttendanceRecord[]
  feeChallans       FeeChallan[]
  announcements     Announcement[]
  quizzes           Quiz[]
  testMarks         TestMark[]
  sharedResources   SharedResource[]
  studentQueries    StudentQuery[]
  notifications     Notification[]
  timetableSlots    TimetableSlot[]

  @@map("academies")
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  passwordHash     String
  fullName         String
  phoneNumber      String?
  role             Role
  accountStatus    AccountStatus @default(PENDING)
  academyId        String
  assignedSections String[]      @default([])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  academy           Academy                   @relation(fields: [academyId], references: [id], onDelete: Cascade)
  parentLinks       ParentStudent[]           @relation("ParentRelation")
  studentLinks      ParentStudent[]           @relation("StudentRelation")
  enrollments       StudentEnrollment[]
  markedAttendance  AttendanceRecord[]        @relation("MarkedBy")
  studentAttendance AttendanceRecord[]        @relation("StudentAttendance")
  taughtClasses     Class[]                   @relation("PrimaryTeacher")
  feeChallans       FeeChallan[]              @relation("StudentChallan")
  createdNotices    Announcement[]            @relation("CreatedBy")
  createdQuizzes    Quiz[]                    @relation("QuizCreatedBy")
  testMarks         TestMark[]                @relation("StudentMarks")
  resources         SharedResource[]          @relation("TeacherResources")
  askedQueries      StudentQuery[]            @relation("StudentQueries")
  answeredQueries   StudentQuery[]            @relation("TeacherQueries")
  ocrDocs           OcrDocument[]             @relation("UserOcrDocs")
  notifications     Notification[]            @relation("RecipientNotifications")
  timetableSlots    TimetableSlot[]           @relation("TeacherTimetable")
  refreshTokens     RefreshToken[]

  @@map("users")
}

model ParentStudent {
  id        String   @id @default(uuid())
  parentId  String
  studentId String
  createdAt DateTime @default(now())

  parent  User @relation("ParentRelation", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("StudentRelation", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@map("parent_student_relationships")
}

model Class {
  id               String   @id @default(uuid())
  academyId        String
  className        String
  section          String
  subject          String
  primaryTeacherId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  academy           Academy             @relation(fields: [academyId], references: [id], onDelete: Cascade)
  primaryTeacher    User?               @relation("PrimaryTeacher", fields: [primaryTeacherId], references: [id], onDelete: SetNull)
  enrollments       StudentEnrollment[]
  attendanceRecords AttendanceRecord[]
  quizzes           Quiz[]
  testMarks         TestMark[]
  sharedResources   SharedResource[]
  studentQueries    StudentQuery[]
  timetableSlots    TimetableSlot[]

  @@unique([academyId, className, section, subject])
  @@map("classes")
}

model StudentEnrollment {
  id        String   @id @default(uuid())
  classId   String
  studentId String
  rollNumber String?
  createdAt DateTime @default(now())

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@map("student_enrollments")
}

model AttendanceRecord {
  id         String           @id @default(uuid())
  academyId  String
  classId    String
  studentId  String
  logDate    String
  status     AttendanceStatus
  markedById String
  recordedAt DateTime         @default(now())

  academy  Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  class    Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student  User    @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  markedBy User    @relation("MarkedBy", fields: [markedById], references: [id], onDelete: Cascade)

  @@unique([classId, studentId, logDate])
  @@map("attendance_records")
}

model FeeChallan {
  id            String    @id @default(uuid())
  academyId     String
  challanNumber String    @unique
  studentId     String
  studentName   String
  fatherName    String?
  classLabel    String
  rollNumber    String?
  issueDate     DateTime  @default(now())
  dueDate       DateTime
  monthlyFee    Decimal   @db.Decimal(10, 2)
  admissionFee  Decimal   @default(0) @db.Decimal(10, 2)
  examFee       Decimal   @default(0) @db.Decimal(10, 2)
  transportFee  Decimal   @default(0) @db.Decimal(10, 2)
  fine          Decimal   @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal   @db.Decimal(10, 2)
  status        FeeStatus @default(PENDING)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  student User    @relation("StudentChallan", fields: [studentId], references: [id], onDelete: Cascade)

  @@map("fee_challans")
}

model Announcement {
  id          String   @id @default(uuid())
  academyId   String
  title       String
  message     String
  targetRoles String[] @default(["all"])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("CreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("announcements")
}

model Quiz {
  id           String    @id @default(uuid())
  academyId    String
  classId      String
  classLabel   String
  title        String
  subject      String
  month        String?
  session      String?
  chapter      String?
  difficulty   String?
  totalMarks   Int
  testDate     DateTime?
  instructions String?
  createdById  String
  createdAt    DateTime  @default(now())

  academy   Academy        @relation(fields: [academyId], references: [id], onDelete: Cascade)
  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy User           @relation("QuizCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  testMarks TestMark[]

  @@map("quizzes")
}

model QuizQuestion {
  id              String   @id @default(uuid())
  quizId          String
  text            String
  type            String   @default("short")
  options         String[] @default([])
  correctIndex    Int?
  marks           Int      @default(5)
  gradingKeywords String[] @default([])

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_questions")
}

model TestMark {
  id              String   @id @default(uuid())
  academyId       String
  quizId          String
  studentId       String
  studentName     String
  classId         String
  subject         String
  month           String?
  marksObtained   Float
  totalMarks      Float
  percentage      Float
  gradeLetter     String
  teacherFeedback String?
  updatedAt       DateTime @updatedAt

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User    @relation("StudentMarks", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId])
  @@map("test_marks")
}

model SharedResource {
  id          String   @id @default(uuid())
  academyId   String
  classId     String
  teacherId   String
  title       String
  description String?
  fileUrl     String
  createdAt   DateTime @default(now())

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User    @relation("TeacherResources", fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("shared_resources")
}

model StudentQuery {
  id         String    @id @default(uuid())
  academyId  String
  classId    String
  studentId  String
  teacherId  String?
  question   String
  answer     String?
  isResolved Boolean   @default(false)
  createdAt  DateTime  @default(now())
  answeredAt DateTime?

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User    @relation("StudentQueries", fields: [studentId], references: [id], onDelete: Cascade)
  teacher User?   @relation("TeacherQueries", fields: [teacherId], references: [id], onDelete: SetNull)

  @@map("student_queries")
}

model OcrDocument {
  id            String   @id @default(uuid())
  createdById   String
  title         String
  extractedText String
  createdAt     DateTime @default(now())

  createdBy User @relation("UserOcrDocs", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("ocr_documents")
}

model Notification {
  id          String   @id @default(uuid())
  academyId   String
  recipientId String
  title       String
  message     String
  type        String   @default("general")
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  academy   Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  recipient User    @relation("RecipientNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model TimetableSlot {
  id        String   @id @default(uuid())
  academyId String
  classId   String
  section   String
  dayOfWeek String
  startTime String
  endTime   String
  subject   String
  teacherId String
  createdAt DateTime @default(now())

  academy Academy @relation(fields: [academyId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User    @relation("TeacherTimetable", fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("timetable_slots")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
